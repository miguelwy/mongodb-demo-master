# Copy to .env and fill in. Never commit .env.

# Atlas connection string (Atlas UI -> Connect -> Drivers)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"

# Database used by every demo in this hub
DB_NAME=mongo_demos

PORT=3000
# Only this machine by default. Use 0.0.0.0 to expose the demo on your network.
HOST=127.0.0.1

# --- Vector Search demo ---------------------------------------------------
# Model used by the autoEmbed index (voyage-4-lite | voyage-4 | voyage-4-large | voyage-code-4)
AUTOEMBED_MODEL=voyage-4

# OPTIONAL: only for the "manual vs automatic" comparison step.
# Automated Embedding itself does NOT need a key on Atlas (billed through your Atlas org).
# Key from https://dash.voyageai.com  -> VOYAGE_API_URL=https://api.voyageai.com/v1
# Key from Atlas (AI Models / Model API keys) -> VOYAGE_API_URL=https://ai.mongodb.com/v1
VOYAGE_API_KEY=
VOYAGE_API_URL=https://api.voyageai.com/v1
MANUAL_EMBED_MODEL=voyage-4
